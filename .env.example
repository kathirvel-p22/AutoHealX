# AutoHealX Docker Compose Environment Variables

# Database Configuration
DB_NAME=autohealx
DB_USER=postgres
DB_PASSWORD=CHANGE_THIS_IN_PRODUCTION

# JWT Secrets (CRITICAL: Generate random secrets for production!)
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=CHANGE_THIS_TO_RANDOM_32_CHAR_STRING_IN_PRODUCTION
JWT_REFRESH_SECRET=CHANGE_THIS_TO_DIFFERENT_32_CHAR_STRING_IN_PRODUCTION

# Frontend Configuration
CORS_ORIGIN=http://localhost:3000

# PRODUCTION DEPLOYMENT INSTRUCTIONS:
# 1. Copy this file to .env: cp .env.example .env
# 2. Generate secure random secrets for JWT_SECRET and JWT_REFRESH_SECRET
# 3. Set a strong DB_PASSWORD
# 4. Update CORS_ORIGIN to your production domain
# 5. Never commit .env to version control
# 6. Use Docker secrets or environment variables in production
