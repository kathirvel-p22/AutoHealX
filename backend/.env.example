# Server Configuration
NODE_ENV=development
PORT=4000
API_VERSION=v1

# Database Configuration
DB_HOST=localhost
DB_PORT=5432
DB_NAME=autohealx
DB_USER=postgres
DB_PASSWORD=your_secure_password_here
DB_POOL_MIN=2
DB_POOL_MAX=10

# JWT Configuration
JWT_SECRET=your_jwt_secret_key_min_32_characters_long_here
JWT_EXPIRY=8h
JWT_REFRESH_SECRET=your_jwt_refresh_secret_key_min_32_characters_long_here
JWT_REFRESH_EXPIRY=7d

# Security
BCRYPT_ROUNDS=12
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# CORS
CORS_ORIGIN=http://localhost:3000

# Logging
LOG_LEVEL=info
LOG_FILE_PATH=./logs

# Feature Flags
ENABLE_AUDIT_LOGGING=true
ENABLE_REQUEST_LOGGING=true


# PRODUCTION SECURITY CHECKLIST:
# [ ] JWT_SECRET is at least 32 characters and randomly generated
# [ ] JWT_REFRESH_SECRET is different from JWT_SECRET
# [ ] DB_PASSWORD is strong and unique
# [ ] All secrets are stored in secure secret management (not in code)
# [ ] CORS_ORIGIN is set to your actual frontend domain
# [ ] SSL/TLS is enabled for database connections
# [ ] NODE_ENV is set to "production"
# [ ] Generate secrets with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
